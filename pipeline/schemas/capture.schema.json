{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nammaspace.org/schemas/capture.schema.json",
  "title": "Capture",
  "description": "Schema for phone video room capture and calibration metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "capture_id",
    "space_name",
    "device_model",
    "os_version",
    "resolution",
    "fps",
    "captured_at",
    "operator",
    "sop_version",
    "lighting",
    "scale_pairs",
    "consent"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version must be 1."
    },
    "capture_id": {
      "type": "string",
      "pattern": "^cap_[a-z2-7]{12}$",
      "description": "Unique capture ID with cap_ prefix and 12 base32 [a-z2-7] characters."
    },
    "space_id": {
      "type": "string",
      "pattern": "^spc_[a-z2-7]{12}$",
      "description": "Optional associated space ID with spc_ prefix and 12 base32 [a-z2-7] characters."
    },
    "space_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name of the space/room."
    },
    "device_model": {
      "type": "string",
      "minLength": 1,
      "description": "Smartphone make and model (e.g. iPhone 15 Pro, Pixel 8)."
    },
    "os_version": {
      "type": "string",
      "minLength": 1,
      "description": "Operating system version."
    },
    "resolution": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Capture video frame rate (e.g. 30.0 or 60.0)."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 recording timestamp."
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "description": "Name or identifier of capture operator."
    },
    "sop_version": {
      "type": "string",
      "minLength": 1,
      "description": "Standard Operating Procedure version used for capture."
    },
    "lighting": {
      "type": "string",
      "minLength": 1,
      "description": "Lighting conditions description (e.g. uniform indoor diffuse)."
    },
    "scale_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "distance_m",
          "role"
        ],
        "properties": {
          "a": {
            "type": "string",
            "minLength": 1
          },
          "b": {
            "type": "string",
            "minLength": 1
          },
          "distance_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "role": {
            "type": "string",
            "enum": [
              "scale",
              "check"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "room_dims_m": {
      "type": "object",
      "required": [
        "width",
        "length",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "required": [
        "granted",
        "reference"
      ],
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
