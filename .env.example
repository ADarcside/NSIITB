# ==============================================================================
# Namma Space Environment Variables Example
# Copy this file to .env and fill in the values. NEVER commit .env to git.
# ==============================================================================

# Object Storage (Cloudflare R2 / S3-compatible)
NS_BUCKET=namma-space-scenes
NS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
NS_ACCESS_KEY_ID=your_access_key_id_here
NS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Asset Hosting & Web Origin
NS_PUBLIC_BASE_URL=https://assets.nammaspace.org
NS_CORS_ORIGIN=https://nammaspace.org

# Reconstruction Pipeline Trainer ('splatfacto' | 'gsplat' | 'brush')
NS_TRAINER=splatfacto

# ------------------------------------------------------------------------------
# Round 2 only (Deferred - Not used in Round 1)
# ------------------------------------------------------------------------------
# NS_API_TOKEN=your_round2_secret_bearer_token
# NS_DB_URL=sqlite:///./namma_space.db
